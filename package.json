{
  "name": "dsh-login-gateway",
  "version": "1.1.0",
  "description": "Remote login gateway for the DeepSeek Harness web UI: username/password login, 24-hour sessions, HTTPS with auto-generated certificates, HTTP/WebSocket reverse proxy to the loopback server, remote produced-file download",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-web-auth": "./lib/cli.js"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "patch-client": "node scripts/patch-dsh-client.mjs",
    "test": "node test/smoke.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./lib/plugin.js": "./lib/plugin.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./lib/plugin-v2.js": "./lib/plugin-v2.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Green1423/dsh-remote-gateway.git"
  },
  "homepage": "https://github.com/Green1423/dsh-remote-gateway",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "auth",
    "gateway",
    "remote",
    "login",
    "https",
    "reverse-proxy"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "zh-CN": "登录网关",
        "en": "Auth Gateway"
      },
      "summary": {
        "zh-CN": "远程登录网关：账号密码登录、24 小时会话、HTTPS 自动生成证书、HTTP/WebSocket 反向代理、产物远程下载。",
        "en": "Remote login gateway: username/password login, 24h sessions, HTTPS with auto-generated certificates, HTTP/WebSocket reverse proxy, remote produced-file download."
      },
      "category": "auth"
    },
    "pluginManager": {
      "group": "auth"
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "license": "MIT"
}
